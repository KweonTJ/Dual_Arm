<?xml version="1.0"?>
<robot name="bioloid_dual_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- load_yaml resolves these paths relative to this Xacro on Windows and ROS. -->
  <xacro:arg name="dimensions_file" default="../config/dimensions.yaml"/>
  <xacro:property name="d" value="${xacro.load_yaml('$(arg dimensions_file)')}"/>
  <xacro:property name="joint_limits" value="${xacro.load_yaml('../config/joint_limits.yaml')['joint_limits']}"/>
  <xacro:property name="parts" value="${xacro.load_yaml('../config/parts.yaml')}"/>
  <xacro:property name="torso" value="${parts['premium_torso']}"/>
  <!-- User dimensions are mm; URDF geometry is expressed in metres. -->
  <xacro:property name="torso_width" value="${torso['width_mm']/1000.0}"/>
  <xacro:property name="torso_depth" value="${torso['depth_mm']/1000.0}"/>
  <xacro:property name="torso_height" value="${torso['height_mm']/1000.0}"/>
  <xacro:property name="torso_wall" value="${torso['wall_mm']/1000.0}"/>
  <xacro:property name="shaft_from_torso_center" value="${torso_height/2-torso['shaft_below_top_mm']/1000.0}"/>
  <xacro:arg name="mount_spacing" default="${d.get('mount_spacing', torso_width+0.040+2*torso['shoulder_gap_mm']/1000.0)}"/>
  <xacro:arg name="mount_height" default="${d['mount_height']}"/>
  <xacro:property name="mount_spacing" value="$(arg mount_spacing)"/>
  <xacro:property name="mount_height" value="$(arg mount_height)"/>
  <xacro:property name="wrist_axis_x" value="${d.get('wrist_axis_x', 0.013)}"/>
  <xacro:include filename="components.xacro"/>
  <xacro:property name="cg" value="${xacro.load_yaml('../config/centered_gripper.yaml')['groups']}"/>
  <xacro:include filename="centered_gripper.xacro"/>
  <xacro:include filename="arm.xacro"/>
  <!-- Fixed floor datum only. The photographed black bench stand is excluded. -->
  <link name="base_link"/>
  <joint name="torso_mount_joint" type="fixed">
    <parent link="base_link"/><child link="torso_link"/>
    <origin xyz="0 0 ${mount_height-shaft_from_torso_center}"/>
  </joint>
  <link name="torso_link">
    <xacro:mesh_visual mesh="premium_torso" material="frame_grey"/>
    <xacro:mesh_visual mesh="torso_mounts" material="frame_grey"/>
    <!-- Shell collision proxies retain the cavity; small mounting bores omitted. -->
    <xacro:box_collision size="${torso_wall} ${torso_width} ${torso_height}" xyz="${(torso_depth-torso_wall)/2} 0 0"/>
    <xacro:box_collision size="${torso_wall} ${torso_width} ${torso_height}" xyz="${-(torso_depth-torso_wall)/2} 0 0"/>
    <xacro:box_collision size="${torso_depth-2*torso_wall} ${torso_width} ${torso_wall}" xyz="0 0 ${(torso_height-torso_wall)/2}"/>
    <!-- F52 bottom has an open cable notch, represented by three box proxies. -->
    <xacro:box_collision size="${torso_depth-2*torso_wall} ${(torso_width-0.0248)/2} ${torso_wall}" xyz="0 ${(torso_width+0.0248)/4} ${-(torso_height-torso_wall)/2}"/>
    <xacro:box_collision size="${torso_depth-2*torso_wall} ${(torso_width-0.0248)/2} ${torso_wall}" xyz="0 ${-(torso_width+0.0248)/4} ${-(torso_height-torso_wall)/2}"/>
    <xacro:box_collision size="0.019 0.0248 ${torso_wall}" xyz="0.0095 0 ${-(torso_height-torso_wall)/2}"/>
    <!-- Fixed torso: estimated assembly mass, outer-box inertia approximation. -->
    <xacro:box_inertia mass="${torso['mass_kg']}" x="${torso_depth}"
                       y="${torso_width}" z="${torso_height}"/>
  </link>
  <xacro:arm prefix="left" side="1"/>
  <xacro:arm prefix="right" side="-1"/>
</robot>
